{
  "family": "monew-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::603831738253:role/monew-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::603831738253:role/monew-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "monew-backend-container",
      "image": "603831738253.dkr.ecr.ap-northeast-2.amazonaws.com/monew/backend:latest",
      "cpu": 0,
      "portMappings": [
        {
          "name": "monew-backend-port-mapping",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        }
      ],
      "secrets": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/monew-backend",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
