{
  "family": "monew-backend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::603831738253:role/monew-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::603831738253:role/monew-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "monew-backend-container",
      "image": "603831738253.dkr.ecr.ap-northeast-2.amazonaws.com/monew/backend:latest",
      "cpu": 0,
      "portMappings": [
        {
          "name": "monew-backend-port-mapping",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        }
      ],
      "secrets": [
        {
          "name": "DB_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:603831738253:parameter/monew/DB_URL"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:603831738253:parameter/monew/DB_USERNAME"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:603831738253:parameter/monew/DB_PASSWORD"
        },
        {
          "name": "MONGO_URI",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:603831738253:parameter/monew/MONGO_URI"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:603831738253:parameter/monew/OPENAI_API_KEY"
        },
        {
          "name": "NAVER_CLIENT_ID",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:603831738253:parameter/monew/NAVER_CLIENT_ID"
        },
        {
          "name": "NAVER_CLIENT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:603831738253:parameter/monew/NAVER_CLIENT_SECRET"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:603831738253:parameter/monew/GEMINI_API_KEY"
        },
        {
          "name": "AWS_BUCKET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:603831738253:parameter/monew/AWS_BUCKET"
        },
        {
          "name": "AWS_S3_BUCKET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:603831738253:parameter/monew/AWS_S3_BUCKET"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/monew-backend",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
